# Populate only the provider(s) you choose. Never commit a populated .env file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Required for live research using Elastic Cloud.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
EVIDENCE_INFERENCE_ID=

# Required for public web search; optional for supplied-source-only research.
TAVILY_API_KEY=

# Optional Jev reranking.
TYPESAFE_API_KEY=

# Optional custom OpenAI-compatible endpoint.
EVIDENCE_CUSTOM_BASE_URL=
EVIDENCE_CUSTOM_API_KEY=

# Optional: use a different nonsecret configuration file.
# EVIDENCE_CONFIG_FILE=C:/path/to/config.toml

# Optional: local evidence snapshots and run database (defaults to OS application data).
# EVIDENCE_DATA_DIR=C:/path/to/evidence-data
